# Estrutura mínima para simular o AD da loonar
# O container executará este LDIF na primeira inicialização.

# Unidades Organizacionais de Serviço e Clientes

dn: ou=03-SERVICOS,DC=loonardc,DC=local
objectClass: top
objectClass: organizationalUnit
ou: 03-SERVICOS

dn: ou=BR-BH,ou=03-SERVICOS,DC=loonardc,DC=local
objectClass: top
objectClass: organizationalUnit
ou: BR-BH

dn: ou=04-CLIENTES,DC=loonardc,DC=local
objectClass: top
objectClass: organizationalUnit
ou: 04-CLIENTES

dn: ou=BR_CATAR,ou=04-CLIENTES,DC=loonardc,DC=local
objectClass: top
objectClass: organizationalUnit
ou: BR_CATAR

# Conta de serviço utilizada pelo Superset

