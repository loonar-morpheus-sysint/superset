# Copie este arquivo para .env e ajuste as variáveis conforme necessário
LDAP_ORGANISATION=Loonar Mock Directory
LDAP_DOMAIN=loonardc.local
LDAP_BASE_DN=DC=loonardc,DC=local
LDAP_ADMIN_PASSWORD=admin
LDAP_CONFIG_PASSWORD=config
LDAP_READONLY_USER=true
LDAP_READONLY_USER_USERNAME=readonly
LDAP_READONLY_USER_PASSWORD=readonly
LDAP_TLS=false
LDAP_MOCK_PORT=3389
LDAP_MOCK_TLS_PORT=3636
LDAP_MOCK_NETWORK=superset
